{
  "expo": {
    "name": "ByteCode App",
    "slug": "bytecode-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bytecode-expo",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bytecode-expo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/finance.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/finance.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.finance.app"
    },
    "splash": {
      "image": "./assets/finance.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/finance.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4a7ea94-fb77-4aa4-8d7d-0eec34b81720"
      }
    }
  }
}
